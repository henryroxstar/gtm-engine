# Secrets — never commit
.env
.env.*
!.env.example
# Per-developer local automation preferences (vault path, custom PATH, etc.)
# Copy .runner_prefs.example → .runner_prefs to customise.
.runner_prefs
# Local-dev env with deliberately public values (see its header) — committed on purpose.
!deploy/.env.dev.example
*.pem
*-credentials.json
google-oauth*.json
# local launch config — carries env/secrets, never commit
.claude/launch.json
# per-user Claude Code settings (e.g. the operator's chosen output style) — never commit
.claude/settings.local.json
# host-specific compose overrides — carry real infra details (networks, DSNs)
# the committed base file omits. Start from docker-compose.override.yml.example.
docker-compose.override.yml

# Customer tenant profiles — local to your installation
profiles/*
!profiles/_template/
!profiles/.keep

# Runtime state (lives on the VPS, not in git) — spec §10, §14
# Includes per-account deliverables under content/<profile>/accounts/<slug>/ (see CLAUDE.md).
content/
*.jsonl
runs/
# ...but `runs/` is unanchored, so it matches a directory named `runs` at ANY depth.
# On 2026-09-02 it silently swallowed the new source package backend/services/runs/
# (git add skipped it; the commit would have shipped an unimportable backend).
# Re-include source packages explicitly; tests/contracts/test_packaging_manifest.py
# fails if any source package is ignored, so a future collision is caught, not shipped.
!backend/services/runs/

# Generated media / large artifacts
*.mp4
*.mp3
*.wav
*.srt
drafts/
podcasts/

# Phase / session verification screenshots — ephemeral, delete when the phase closes
# Agent codemod + maintenance scripts belong in scripts/<area>/, never root
phase*-*.png
# Stray content exports (deck slides, carousel/infographic PNGs) belong under content/<active>/
# (gitignored above) — this root-anchored rule catches any that land at the repo root by mistake.
# Root-only: it does NOT touch tracked PNGs in subfolders (docker/, profiles/.../brand, etc.).
/*.png

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/

# Tooling state (local, not in git)
.serena/
# actionlint binary (downloaded locally to lint workflows; CI fetches its own)
/actionlint
# brainstorm screens + one-off scaffold scripts
.superpowers/
# local session hooks (pre/post-tool scripts)
.claude/hooks/*
!.claude/hooks/secret-paste-guard.sh
!.claude/hooks/send-guard.sh
!.claude/hooks/send-leaves.txt
# playwright browser state and artifacts
.playwright-mcp/
# Strix pentest run output (SARIF/CSV/JSON/logs) — local security-scan artifacts
strix_runs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# Onboarding staging area — draft profile bundles awaiting operator review
profiles/.staging/

# Inbound vendor/brand drops staged for review — never committed from here.
# Anything worth keeping is curated into profiles/<tenant>/knowledge/ deliberately.
# (One 2026-09-02 tenant brand drop was 139 MB against an 87 MB .git.)
/tmp/
