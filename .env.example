# gtm-engine — environment template  ·  LOCAL-DEV DOCUMENTATION ONLY
# =============================================================================
# Variables are grouped by TIER so you only set what your use case needs:
#
#   TIER 0 — required for ANY use (Claude Cowork skills, drafting, planning)
#   TIER 1 — optional; unlocks the content pipeline + richer research
#   TIER 2 — self-hosting / advanced only (VPS deployment, publishing, media)
#
# Claude Cowork users: you only need TIER 0 (ANTHROPIC_API_KEY). Run "set me up"
# and the agent handles the rest. Everything below TIER 0 is optional.
#
# This file is the canonical *catalog* of every variable the system reads — it is
# documentation, NOT how secrets reach a deployment. For self-hosting, secrets are
# injected by your secret manager (see docs/DEPLOY.md); this committed file holds
# only generic placeholders and is NEVER where real values live.
#
# Local dev:
#   cp .env.example .env        # .env is gitignored — NEVER commit it
#   # fill in the values, then load them into your shell:
#   set -a; source .env; set +a
#
# Keep this list in sync with agent/config.Config.from_env().
# =============================================================================


# =============================================================================
# TIER 0 — REQUIRED (the brain)
# =============================================================================
ANTHROPIC_API_KEY=          # REQUIRED — Claude Code / Agent SDK orchestrator. Nothing runs without this.


# =============================================================================
# TIER 1 — OPTIONAL (content pipeline + richer research; safe fallbacks exist)
# =============================================================================

# Worker model — cheap bulk first-drafts behind an MCP tool (Claude always reviews).
# Unset → the brain falls back to a Claude worker (works, just costs more).
DEEPSEEK_API_KEY=

# Firecrawl MCP — structured web scraping for research/market-scan/prospecting.
# Unset → skills fall back to the built-in keyless web tools (WebSearch/WebFetch),
# which are weaker but require no key.
FIRECRAWL_API_KEY=

# Vibe Prospecting — OAuth MCP connector (claude.ai connector settings, or `claude mcp`
# in an interactive session); there is no API key to set here. Because OAuth connection
# state isn't visible to this process's environment, set this to "true" once you've
# authorized the connector so the capability probe (gtm_core/capabilities.py) stops
# reporting prospect-via-web as the active fallback. Leave unset/false otherwise.
VIBE_PROSPECTING_CONNECTED=false

# Syften MCP — community/social-listening reads (agent/mcp/syften), used by the
# community-signal-analysis skill. Read-only wrapper: no filter-write tool exists,
# so filter changes stay a human, dashboard action.
# Unset → the server is omitted (fail-closed) and the skill falls back to a manual
# CSV drop from the Syften dashboard.
SYFTEN_API_KEY=

# RocketReach worker (agent/mcp/rocketreach) — contact resolution + Intentsify
# topic-intent + news/hiring/job-change signal search for prospect/call-prep.
# Unset → the worker is omitted entirely (fail-closed) and prospect falls back to
# Vibe enrichment or public web. Capture the connected plan's real allowance +
# entitled features in PROFILE.md §"Connector plans & entitlements" — a dollar
# budget can't gate a flat-subscription tool like this one.
ROCKETREACH_API_KEY=

# Apollo worker (agent/mcp/apollo) — the third leg of the contact waterfall.
# Unset → the worker is omitted entirely (fail-closed); the waterfall just ends a
# step earlier. Treat the first run as a smoke test (see agent/mcp/apollo/__init__.py).
APOLLO_API_KEY=
# Rarely needed — advanced tuning only, safe to leave unset:
#   ROCKETREACH_BASE_URL              override the classic v2 host (tests only)
#   ROCKETREACH_SEARCH_API            "classic" (default) | "universal" — EXPERIMENTAL,
#                                      unverified against a live account, see the
#                                      module docstring in agent/mcp/rocketreach/server.py
#                                      before ever setting this outside a test
#   ROCKETREACH_UNIVERSAL_BASE_URL    override the Universal search host (tests only)
#   ROCKETREACH_USD_PER_LOOKUP        override the $/lookup rate (default 0 — flat sub)

# Saleshandy MCP — email-sequence staging (in-repo wrapper agent/mcp/saleshandy).
# Auth is an x-api-key header; the key stays server-side and the brain never sees it.
# Unset → the email-sequence skill falls back to a manual, paste-ready plan.
# STAGING ONLY: the wrapper cannot activate or send a sequence (no resume tool exists) —
# a human flips it live in Saleshandy.
SALESHANDY_API_KEY=
# SC9 (2026-09-21). Both closed by default; unset or unrecognised means OFF.
# GTM_DNC_ADD_ENABLED lets an APPROVED dnc_add gate actually write to the provider's
# do-not-contact list. With it unset the gate still runs and still shows the operator
# the addresses — it just writes nothing, and says so.
GTM_DNC_ADD_ENABLED=
# GTM_CAPABILITY_AUTOSET_ENABLED lets the compliance preflight emit an AUTOSET PLAN line
# for a setting on the hardcoded allowlist. It never writes; the plan is for a human.
GTM_CAPABILITY_AUTOSET_ENABLED=
# Which DNC list to write to. Only needed when the account has more than one — with a
# single list the dispatcher resolves it, and with several it refuses rather than guess.
SALESHANDY_DNC_LIST_ID=

# Scorecard engine (2026-09-22). NOTE THE INVERTED DEFAULT: unlike every switch above, these
# two are ON when unset, and only a recognised false value (0/false/no/off) turns them off. They
# do not enable an external effect — they enable a REFUSAL, so default-off would be fail-open and
# would make the gate inert on the machine that most needs it. Anything unrecognised therefore
# leaves the refusal in place.
# GTM_SCORECARD_ENABLED=0 makes `gtm_core.scorecard` refuse to run at all (fall back to scoring
# by hand against the profile's prose rubric).
GTM_SCORECARD_ENABLED=
# GTM_SCORECARD_STRICT_PROVENANCE=0 lets `prospects_import finalize` accept a scored row that
# does not name the rubric it was scored against. On (the default) it exits 2 and writes nothing.
GTM_SCORECARD_STRICT_PROVENANCE=

# Per-run budget stop (USD). Hard SDK-level cap per run; mirrors PROFILE per_run_cap_usd.
PER_RUN_CAP_USD=10

# Approve-and-resume over Telegram for the ESCALATE class only — an escalated tool
# call is pushed to the operator instead of being denied outright. Default off; a
# decline or a timeout denies (fail closed). Never a way around a hard deny.
APPROVE_RESUME_ENABLED=false
# Seconds to wait for that approval before denying. Unset → 180.
APPROVE_RESUME_TIMEOUT_S=

# Per-run cost cap for onboarding ingest (Firecrawl crawl + extract call), checked
# against content/_system/costs.jsonl before the crawl (§R2). Unset = uncapped —
# only appropriate in dev.
GTM_ONBOARDING_CAP_USD=

# Optional model override (default: claude-sonnet-4-6); e.g. claude-opus-4-8 for heavy runs.
HERMES_MODEL=


# =============================================================================
# TIER 2 — SELF-HOSTING / ADVANCED ONLY
# Not needed for Claude Cowork. See docs/DEPLOY.md before setting these.
# Use generic placeholders below; real values belong in your secret manager or a
# gitignored .env / docker-compose.override.yml — never committed.
# =============================================================================

# --- Cockpit (Telegram bot) — only for an unattended self-hosted deployment ---
# In Cowork the chat IS the interface; you do NOT need a Telegram bot. To run the
# bot, create your OWN bot via @BotFather and use your own chat id.
TELEGRAM_BOT_TOKEN=         # your operator bot token (from @BotFather)
TELEGRAM_ALLOWED_CHAT_ID=   # whitelist: ONLY this chat_id may talk to / approve

# --- News feed (read-only Postgres over a `discovery_items` table) ---
# Optional. Unset → the radar uses the keyless web-sweep fallback automatically.
# Self-hosting only: point this at your own read-only DB role.
NEWS_DB_DSN=                # postgresql://user:password@host:5432/dbname

# --- Google Workspace (self-hosted CLI-MCP; personal account, least-privilege) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN= # least-privilege scopes; send/write only where needed

# --- Media (image + video) ---
# REST/platform API auth is a key:secret PAIR (Authorization: Key <key>:<secret>); the
# MCP/CLI path uses account OAuth instead (no key). Pick one.
HIGGSFIELD_API_KEY=         # REST access key
HIGGSFIELD_API_SECRET=      # REST secret (paired with the key)
ELEVENLABS_API_KEY=         # podcast voices (Phase 4) + cockpit voice TTS/STT
ELEVENLABS_VOICE_ID=        # optional; defaults to Fahco4VZzobUeiPqni1S (Archer — Conversational)
GEMINI_API_KEY=             # headless image gen (gemini-3-pro-image-preview), agent/mcp/gemini_image

# NOTE: the Phase 4 podcast agent engine (Hermes orchestrator webhook, Mode B on
# DeepSeek) is a planned, unbuilt phase. It has no env vars yet; this file only
# catalogs what Config.from_env() reads today.

# --- LinkedIn publish (Gate 2 — the ONLY outbound-posting path) ---
# Hermes posts ONLY by calling a dedicated n8n webhook that is write-only and has
# the target LinkedIn account PINNED server-side. Hermes therefore needs NO
# PostForMe key and NO account id — least privilege. The secret is a DEDICATED
# Hermes bearer (generate fresh: `openssl rand -hex 32`), never a shared secret.
# Publishing fires only after a human Approve in the cockpit. Default OFF.
HERMES_PUBLISH_URL=          # https://your-n8n-host/webhook/hermes-linkedin-publish
HERMES_PUBLISH_SECRET=       # dedicated bearer for Hermes ONLY (not a shared secret)
HERMES_PUBLISH_ENABLED=false # kill switch — capability stays OFF until set to true
# HERMES_PUBLISH_MAX_PER_HOUR=5   # optional client-side rate cap (default 5)
# HERMES_PUBLISH_MAX_CHARS=3000   # optional post length guard (default 3000)
HERMES_SCHEDULE_ENABLED=false # scheduling's OWN opt-in, on top of HERMES_PUBLISH_ENABLED —
                               # enabling immediate publish is not consent for posts to fire
                               # days later unattended; a scheduled draft dispatches nothing
                               # while this is false, never falls back to publishing now
# HERMES_SCHEDULE_MAX_HORIZON_DAYS=90 # optional — how far ahead a schedule may be requested

# --- Reply-send (linkedin-reply / inbound-triage — same gate shape as publish) ---
# With no transport configured the reply gate stages the reply for manual send (the
# safe default). A transport is only used when REPLY_SEND_ENABLED is truthy AND a
# clean https URL + secret are both present. Default OFF.
REPLY_SEND_URL=              # https://your-transport-host/webhook/reply-send
REPLY_SEND_SECRET=           # dedicated bearer for this transport ONLY
REPLY_SEND_ENABLED=false     # kill switch — capability stays OFF until set to true
# REPLY_SEND_MAX_PER_HOUR=20    # optional client-side rate cap (default 20)
# REPLY_SEND_MAX_CHARS=5000     # optional reply length guard (default 5000; email > LinkedIn)

# --- Publishing (PER-PROFILE — legacy placeholders; NOT used by Hermes) ---
# Hermes does NOT read these. The account-pinned webhook above is the only publish
# path; do NOT give Hermes a PostForMe API key (that would be over-privileged).
# One token pair per profile slug, e.g.:
# <PROFILE>_POSTFORME_TOKEN=
# <PROFILE>_YOUTUBE_TOKEN=

# --- Deck renderer sidecar (Slidev/Playwright/Chromium — headless export) ---
# Omit to keep deck export local (the skill falls back to the local guide). The
# deck-theme is baked into the sidecar image — no workspace path needed.
DECK_RENDERER_URL=http://deck-renderer:3000
# The URL's host must be allow-listed or export_deck refuses to call it (SSRF guard:
# an unvalidated URL here could be pointed at cloud instance metadata). Defaults cover
# every shipped config — deck-renderer, localhost, 127.0.0.1, ::1 — so leave this unset
# unless the sidecar genuinely runs under another hostname. Comma-separated.
# DECK_RENDERER_ALLOWED_HOSTS=my-renderer.internal

# --- Default profile (session-bound; per-chat /profile overrides — no global switch) ---
ACTIVE_PROFILE=_template     # DEFAULT only; each chat binds its own profile

# --- Second agent stack on the same box (INTERNAL operators only) ---
# Compose-substitution vars (parse time — NOT passed into the container). Unset =
# today's single-stack behaviour, byte-identical. A second stack must override ALL
# four: `docker compose -p` does not scope container names, bind mounts, or an
# explicitly-named network. NOT the customer tenancy model — customers get
# workspaces on the backend API.
# GTM_AGENT_CONTAINER=gtm-agent2           # default: gtm-agent
# GTM_RENDERER_CONTAINER=deck-renderer2    # default: deck-renderer
# GTM_CONTENT_DIR=/opt/gtm-content-agent2  # default: ./content  (own host dir!)
# GTM_NETWORK_NAME=gtm-engine-agent2        # default: gtm-engine
