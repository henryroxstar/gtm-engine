{
  "mcpServers": {
    "worker": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "agent.mcp.worker",
        "--transport",
        "stdio"
      ],
      "env": {
        "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}"
      }
    },
    "vision": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
