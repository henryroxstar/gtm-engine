# GTM Backend — LOCAL DEVELOPMENT ONLY. Copy-and-go, no edits needed:
#   cp deploy/.env.dev.example deploy/.env.dev
#   docker compose --env-file deploy/.env.dev \
#     -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml \
#     -p gtm_infra_dev up -d --build
#
# Every value in this file is DELIBERATELY PUBLIC: it is committed to git and identical on
# every laptop, so it protects nothing. It is safe only for a throwaway stack bound to
# loopback. NEVER use this file, or any value from it, for staging or production — those
# take real secrets from your secret manager; deploy/.env.example is the reference for that.
#
# Anything not set here falls back to the defaults in deploy/docker-compose.yml.

# ── Environment ───────────────────────────────────────────────────────────────
# development: relaxes the production boot guards (CORS allow-list, two-role Postgres
# passwords) and turns on uvicorn reload.
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8081,http://127.0.0.1:19006

# ── Postgres (fixed local values — the volume is created with these on first up) ─
POSTGRES_DB=gtm_backend
POSTGRES_USER=gtm_app
POSTGRES_PASSWORD=local-dev-only-postgres
POSTGRES_GTMAPI_PASSWORD=local-dev-only-gtm-api

# ── Backend API ───────────────────────────────────────────────────────────────
# 32+ bytes so HS256 does not warn. Public, so any token it signs is forgeable by anyone.
BACKEND_JWT_SECRET=local-dev-only-jwt-signing-value-0000
BACKEND_JWT_EXPIRE_MINUTES=60
BACKEND_REFRESH_EXPIRE_DAYS=30
BILLING_SYNC_SECRET=local-dev-billing-sync-secret
RATELIMIT_ENABLED=false
BACKEND_WORKERS=1
REDIS_URL=redis://redis:6379/0
# BYOK credential vault KEK (backend/vault.py) — must be exactly 32 bytes of hex
# (64 hex chars). Public dev value only; deploy/.env.example takes a real one
# generated with `openssl rand -hex 32`.
VAULT_KEK=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# ── Runs ──────────────────────────────────────────────────────────────────────
# Dev-only fake run executor: runs complete without calling a model, so the full run
# lifecycle works with no API key. Only forwarded by deploy/docker-compose.dev.yml.
GTM_FAKE_RUNS=1
# Total scripted delay across a fake run's nodes, in seconds. Commented out (empty or
# unset both mean the same 1.0s default — backend/services/runs/fake.py). Uncomment
# and raise it to exercise cancelling a run mid-node.
#GTM_FAKE_RUN_DELAY_S=5
# Node id at which a fake run fails — the run ends `failed` exactly as a real node failure
# does, so the failed-run UI can be built without a key. Commented out (empty or unset both
# mean nothing fails). Use a node id of the run you start: `draft` for a prompt run, or a
# pack variant's own node (e.g. `sequence` for prospecting); any other value is ignored,
# with a warning in the api log.
#GTM_FAKE_RUN_FAIL_NODE=draft
# The same flag scripts onboarding: POST /v1/onboard needs no model key, and a `url` source
# needs no FIRECRAWL_API_KEY (no page is fetched; the company name comes from the host).
# Seconds each scripted onboarding job waits before its draft is ready. Commented out
# (empty or unset both mean 1.0s — backend/services/onboard_fake.py). Raise it to watch
# the job poll through pending/running.
#GTM_FAKE_ONBOARD_DELAY_S=5
# Real (non-fake) runs need a key, and every run bills whoever owns it. Leave empty
# unless you mean to spend on your own key.
ANTHROPIC_API_KEY=

# ── Optional integrations (off locally) ───────────────────────────────────────
# Empty ⇒ POST /v1/auth/exchange returns 503 federation_not_configured.
TRUSTED_ISSUERS=
# Empty ⇒ push is a no-op; clients poll.
PUSH_PROVIDER=
PUSH_FCM_SERVICE_ACCOUNT_JSON=
# ST-03: system-tray title override. Unset ⇒ "GTM — action needed".
PUSH_TITLE=
# Only used by cloudflared, which the dev override keeps behind `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
