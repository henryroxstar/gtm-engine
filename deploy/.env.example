# GTM backend: environment for deploy/docker-compose.yml
#
# Copy to deploy/.env and replace every CHANGE_ME value. docker compose reads deploy/.env
# automatically (deploy/ is the project directory). Keep the real file out of git, or load
# these values from your own secret manager instead of a file on disk.
# Walkthrough: docs/DEPLOY-BACKEND.md.
#
# Generate each secret with:  openssl rand -hex 32
# Apply a change with:        docker compose up -d --force-recreate
# (`docker compose restart` does NOT re-read this file.)

# ── Postgres ──────────────────────────────────────────────────────────────────
# Two-role model: POSTGRES_USER (gtm_app) OWNS the tables and runs migrations. The backend's
# RUNTIME pool connects as the non-owner gtm_api role, so FORCE ROW LEVEL SECURITY is actually
# enforced (an owner or superuser bypasses it). Set BOTH passwords to distinct strong random
# values. gtm_api is created by a migration; its password is set from POSTGRES_GTMAPI_PASSWORD
# at backend startup. Use URL-safe characters (hex is fine): they are embedded in a DSN.
POSTGRES_DB=gtm_backend
POSTGRES_USER=gtm_app
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_GTMAPI_PASSWORD=CHANGE_ME_different_strong_random_password

# ── Backend API ───────────────────────────────────────────────────────────────
ENV=production
BACKEND_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
BACKEND_JWT_EXPIRE_MINUTES=60
BACKEND_REFRESH_EXPIRE_DAYS=30
BACKEND_PORT=8000
# Comma-separated browser origins allowed to call the API. Do NOT leave the compose default of
# "*": with ENV=production an unset or wildcard value fails the boot instead of serving a
# permissive policy.
CORS_ORIGINS=https://app.example.com

# POST /v1/auth/register creates a user plus a workspace. It is open by default so you can create
# the first account; set false once your accounts exist (or when users sign in through
# TRUSTED_ISSUERS), so an internet-reachable API does not accept strangers.
ALLOW_NATIVE_REGISTRATION=true

# Which profile under profiles/ a run reads when none is bound. The image ships a company-agnostic
# template; point this at your own profile once you have created one.
ACTIVE_PROFILE=template

# ── Shared state ──────────────────────────────────────────────────────────────
# Redis backs the rate limiter and the cross-worker SSE / gate-wake fan-out. One resolver serves
# both (RATELIMIT_STORAGE_URI wins, REDIS_URL is the fallback), so they cannot end up pointed at
# different instances. The compose file ships a `redis` service and points this at it.
REDIS_URL=redis://redis:6379/0
# Set only to point the shared storage somewhere other than REDIS_URL.
RATELIMIT_STORAGE_URI=
RATELIMIT_ENABLED=true

# uvicorn worker count. Correctness never depends on Redis (Postgres owns the queue, the gate
# decision and the event log), but more than 1 worker with no reachable Redis REFUSES to boot
# rather than silently running on per-process rate limits. Raise it deliberately.
BACKEND_WORKERS=1

# Rate-limit proxy trust (defence in depth). By default the limiter trusts the client-IP headers
# your reverse proxy sets. Anyone who reaches the origin directly can forge them. Set this to a
# strong random value AND have your proxy add request header `X-GTM-Proxy-Secret: <same value>`;
# the limiter then trusts the client-IP headers only on requests carrying the matching secret.
# Leave empty only when the proxy is verifiably the sole ingress.
RATELIMIT_PROXY_SECRET=

# ── External identity provider (optional) ─────────────────────────────────────
# JSON array of trusted issuers. Validated at boot: every jwks_url must be https and every alg
# asymmetric (RS*/ES*/PS*), or the container refuses to start. Empty means
# POST /v1/auth/exchange returns 503 (federation off).
# TRUSTED_ISSUERS=[{"issuer":"https://idp.example","jwks_url":"https://idp.example/.well-known/jwks.json","audience":"gtm-backend","algs":["RS256"],"subject_claim":"sub"}]
TRUSTED_ISSUERS=

# ── Push notifications (optional, FCM HTTP v1) ────────────────────────────────
# PUSH_FCM_SERVICE_ACCOUNT_JSON takes the service-account JSON itself or a path to it. Empty
# means push is a no-op and clients fall back to polling GET /v1/runs/{id}.
PUSH_PROVIDER=
PUSH_FCM_SERVICE_ACCOUNT_JSON=
PUSH_TITLE=

# ── Billing (optional) ────────────────────────────────────────────────────────
# This stack integrates with no billing vendor. It stores and enforces a spend cap that an
# external billing system pushes to PUT /v1/entitlement/{workspace_id}, authenticated by this
# SERVICE secret (never a user token). Set the same value in that system. Leave empty to disable
# the route.
BILLING_SYNC_SECRET=
# Which payment channel credits wallets; empty leaves the code default.
BILLING_SERVICE_ENABLED=
# Where a payment-required refusal sends the caller. Empty means the refusal names no link.
BILLING_URL=
PRICING_URL=

# ── BYOK credential vault ─────────────────────────────────────────────────────
# 32-byte (64 hex char) Key Encryption Key for AES-256-GCM envelope encryption of the third-party
# API keys a workspace supplies (backend/vault.py). Empty means the vault fails closed:
# PUT /v1/integrations/{provider} returns 503, never a plaintext fallback. Losing this key makes
# every stored credential unreadable, so back it up separately from the database.
VAULT_KEK=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Optional ingress: Cloudflare Tunnel ───────────────────────────────────────
# Only read with `--profile tunnel`. Create the tunnel in the Cloudflare dashboard, point its
# public hostname at http://api:8000, and paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# ── MCP server ────────────────────────────────────────────────────────────────
MCP_PORT=8001
# Shared secret an authenticating proxy in front of the MCP server sends in X-Gateway-Secret.
MCP_GATEWAY_SECRET=
# Where the "finish setup" error sends a developer whose workspace has no profile yet.
SETUP_URL=
DEEPSEEK_API_KEY=
# Per-1K-token prices used to meter the worker model. Override only if the provider's prices change.
# DEEPSEEK_INPUT_USD_PER_1K=0.00027
# DEEPSEEK_OUTPUT_USD_PER_1K=0.00110

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Connectors (every one is off while empty) ─────────────────────────────────
NEWS_DB_DSN=
HERMES_PUBLISH_URL=
HERMES_PUBLISH_SECRET=
HERMES_PUBLISH_ENABLED=false
# HERMES_PUBLISH_MAX_PER_HOUR=5
# HERMES_PUBLISH_MAX_CHARS=3000
# Scheduling is its own opt-in on top of HERMES_PUBLISH_ENABLED, closed by default.
HERMES_SCHEDULE_ENABLED=false
# HERMES_SCHEDULE_MAX_HORIZON_DAYS=90
PUBLISH_LINKEDIN_WEBHOOK_URL=
PUBLISH_LINKEDIN_WEBHOOK_SECRET=
REPLY_SEND_URL=
REPLY_SEND_SECRET=
REPLY_SEND_ENABLED=false
TELEGRAM_BOT_TOKEN=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
ROCKETREACH_API_KEY=
APOLLO_API_KEY=
SALESHANDY_API_KEY=
SYFTEN_API_KEY=
# Vibe Prospecting is an OAuth MCP connector with no API key. Set to "true" once authorized so
# gtm_core/capabilities.py stops reporting prospect-via-web as inactive.
VIBE_PROSPECTING_CONNECTED=false
GTM_ONBOARDING_CAP_USD=

# ── Optional switches (all closed while empty) ────────────────────────────────
# House-pooling of a provider key across tenants. An exact yes turns one on; a tenant otherwise
# must bring its own key.
GTM_POOL_ROCKETREACH=
GTM_POOL_APOLLO=
# Mirror a detected opt-out onto the sequencer's Do Not Contact list. Add-only.
GTM_DNC_ADD_ENABLED=
GTM_CAPABILITY_AUTOSET_ENABLED=
SALESHANDY_DNC_LIST_ID=
# POST /v1/agents/provision (one-call agent setup). Shut (404) unless an unambiguous on.
GTM_AGENT_PROVISION_ENABLED=
# Start each tenant run's CLI as that workspace's own OS user via the setcap gtm-launch binary
# built into the image. Off unless exactly 1, and the backend refuses to boot with it on when
# the box cannot launch tenant runs. See docs/DEPLOY-BACKEND.md before enabling.
GTM_TENANT_LAUNCHER=

# npm package name the agent-provisioning response prints in its MCP client snippet. Unset prints a
# placeholder.
# GTM_MCP_BRIDGE_PACKAGE=

# ── Optional object storage (S3-compatible, e.g. Cloudflare R2) ───────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET=gtm-public-prd
R2_PUBLIC_BASE_URL=

# ── Queue worker ──────────────────────────────────────────────────────────────
# The separate `worker` service always runs the queue. Leave this false on the api so a run is
# claimed once.
QUEUE_WORKER_ENABLED=false
GTM_WORKER_MAX_CONCURRENT_RUNS=4
GTM_MAX_WARM_SESSIONS=8
# Seconds a draining worker waits for in-flight runs; keep it under the worker's stop_grace_period (180s).
GTM_WORKER_DRAIN_TIMEOUT_S=170
RESERVATION_TTL_SECONDS=90000
# process (default) or container. container needs GTM_DOCKER_HOST pointing at a Docker socket
# proxy; see docs/DEPLOY-BACKEND.md.
GTM_RUN_ISOLATION=process
GTM_DOCKER_HOST=
GTM_CONTAINER_MEMORY=1024m
GTM_CONTAINER_CPUS=1.0
GTM_CONTAINER_PIDS_LIMIT=256
GTM_RUNNER_IMAGE=gtm-backend:latest
GTM_RLIMIT_NPROC=1024
GTM_RLIMIT_FSIZE=536870912
GTM_RLIMIT_CPU=1800
